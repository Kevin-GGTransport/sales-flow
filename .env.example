# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，凭证勿提交）

# Neon PostgreSQL：运行时连接（pooler 池化端点）
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon 直连端点（host 去掉 -pooler），供 prisma migrate 建表/迁移使用
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# NextAuth 会话签名密钥：openssl rand -base64 32
AUTH_SECRET=""

# 初始管理员（仅首次 seed 建号使用；登录后请立即改密）
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD=""
